# Copy this file to .env.local and fill in your SMTP credentials.
# .env.local is git-ignored: never commit real passwords.

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=chaima.harzi@etudiant-fst.utm.tn

# SMTP account used to send the messages.
# Example with Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: sender address (defaults to SMTP_USER). Most providers require it
# to be the same account as SMTP_USER.
# CONTACT_FROM_EMAIL=
